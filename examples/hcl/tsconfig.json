{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "#reylo-example-types": ["./node_modules/@totto2727/reylo/src/index.d.ts", "../../src/index.ts"]
    }
  },
  "contentMappers": [
    {
      "package": "@totto2727/reylo",
      "extensions": [".sql", ".reylo.yaml", ".reylo.yml"]
    }
  ],
  "include": ["main.ts", "sql-types.d.ts"]
}
