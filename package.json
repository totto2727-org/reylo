{
  "name": "@totto2727/reylo",
  "version": "0.6.0",
  "private": true,
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "description": "Import SQL files as fully typed queries. A TypeScript content mapper plus a runtime loader.",
  "license": "MIT",
  "author": "Colin McDonnell",
  "homepage": "https://reylo.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/totto2727-org/reylo.git"
  },
  "bugs": "https://github.com/totto2727-org/reylo/issues",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "reylo": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./register": "./src/register.ts",
    "./vite": "./src/vite.ts",
    "./esbuild": "./src/esbuild.ts",
    "./webpack": "./src/webpack.ts",
    "./turbopack": "./src/turbopack.ts",
    "./next": "./src/next.ts",
    "./jest": "./src/jest.ts"
  },
  "typescript": {
    "contentMapper": {
      "exec": [
        "node",
        "src/mapper.ts"
      ],
      "compilerOptions": [],
      "dynamicConfig": true
    }
  },
  "scripts": {
    "build": "nub scripts/build.ts",
    "typecheck": "tsc --noEmit --runExternalCode",
    "test": "node --test 'tests/**/*.test.ts'"
  },
  "devDependencies": {
    "@bytecodealliance/preview2-shim": "0.30.0",
    "@totto2727/reylo-sqlite": "link:packages/sqlite",
    "@types/node": "^26.6.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.1.0-dev.20260918.1"
  },
  "peerDependencies": {
    "@totto2727/reylo-sqlite": "0.6.0"
  },
  "peerDependenciesMeta": {
    "@totto2727/reylo-sqlite": { "optional": true }
  }
}
